@{
    ViewData["Title"] = "تسجيل الدخول";
    var errorMsg = ViewBag.ErrorMessage as string ?? ViewBag.Error as string;
    var savedEmail = ViewBag.Email as string ?? "";
}

<div class="row justify-content-center align-items-center" style="min-height: 72vh;" dir="rtl">
    <div class="col-md-6 col-lg-5">
        <div class="card border-0 shadow-lg" style="border-radius: 18px !important;">
            <div class="text-center text-white p-4" style="background: linear-gradient(135deg, #1E3A8A 0%, #2563EB 60%, #0D9488 100%);">
                <div class="mb-2" style="font-size: 2.4rem;">🎓</div>
                <h3 class="text-white mb-1 fw-bold">منصة StepByStep</h3>
                <p class="mb-0 small opacity-75">بوابة المعلمين والطلاب وأولياء الأمور</p>
            </div>

            <div class="card-body p-4 p-md-5">
                <h5 class="text-center mb-4 fw-bold text-secondary">تسجيل الدخول إلى حسابك</h5>

                @if (!string.IsNullOrWhiteSpace(errorMsg) || !ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger mb-3" role="alert">
                        @if (!string.IsNullOrWhiteSpace(errorMsg))
                        {
                            <div>@errorMsg</div>
                        }
                        else
                        {
                            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                            {
                                <div>@error.ErrorMessage</div>
                            }
                        }
                    </div>
                }

                <form asp-action="Login" method="post">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label class="form-label">البريد الإلكتروني</label>
                        <input type="email" name="email" value="@savedEmail" class="form-control form-control-lg" placeholder="name@school.com" required />
                    </div>

                    <div class="mb-4">
                        <label class="form-label">كلمة المرور</label>
                        <input type="password" name="password" class="form-control form-control-lg" placeholder="••••••••" required />
                    </div>

                    <div class="d-grid">
                        <button type="submit" class="btn btn-primary btn-lg fw-bold">دخول إلى المنصة</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>