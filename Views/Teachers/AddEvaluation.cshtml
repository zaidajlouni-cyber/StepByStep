@model StepByStep.Models.WeeklyEvaluation

@{
    ViewData["Title"] = "إضافة تقييم أسبوعي";
}

<div class="container mt-5" dir="rtl" style="text-align: right;">
    <h2>إضافة تقييم أسبوعي للطالب</h2>
    <hr />
    <form asp-action="AddEvaluation" method="post">

        <div class="mb-3">
            <label class="form-label">اختر الطالب:</label>
            <select asp-for="StudentId" class="form-control" asp-items="@(ViewBag.Students ?? new SelectList(Enumerable.Empty<SelectListItem>()))">
                <option value="">-- اختر الطالب --</option>
            </select>
        </div>

        <div class="mb-3">
            <label class="form-label">اختر المادة:</label>
            <select asp-for="SubjectId" class="form-control" asp-items="@(ViewBag.Subjects ?? new SelectList(Enumerable.Empty<SelectListItem>()))">
                <option value="">-- اختر المادة --</option>
            </select>
        </div>

        <div class="mb-3">
            <label class="form-label">رقم الأسبوع:</label>
            <input asp-for="WeekNumber" class="form-control" type="number" required />
        </div>

        <div class="mb-3">
            <label class="form-label">التقييم (من 5):</label>
            <input asp-for="Score" class="form-control" type="number" step="0.1" min="1" max="5" required />
        </div>

        <div class="mb-3">
            <label class="form-label">ملاحظات المعلم:</label>
            <textarea asp-for="TeacherNotes" class="form-control"></textarea>
        </div>

        <button type="submit" class="btn btn-success">حفظ التقييم</button>
        <a asp-action="Index" class="btn btn-secondary">إلغاء</a>
    </form>
</div>