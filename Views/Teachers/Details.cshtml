@model StepByStep.Models.Teacher

@{
    ViewData["Title"] = "تفاصيل المعلم";
}

<div class="container mt-4" dir="rtl" style="text-align: right;">
    <div class="card shadow-sm col-md-8 mx-auto">
        <div class="card-header bg-info text-white">
            <h4>تفاصيل المعلم</h4>
        </div>
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-4">رقم المعلم (ID):</dt>
                <dd class="col-sm-8">@Model.TeacherId</dd>

                <dt class="col-sm-4">اسم المعلم:</dt>
                <dd class="col-sm-8">@ViewBag.UserName</dd>

                <dt class="col-sm-4">التخصص:</dt>
                <dd class="col-sm-8">@Model.Specialization</dd>
            </dl>
            <div class="d-flex justify-content-between mt-4">
                <a asp-action="Index" class="btn btn-secondary">العودة للقائمة</a>
                <a asp-action="Edit" asp-route-id="@Model?.TeacherId" class="btn btn-primary">تعديل البيانات</a>
            </div>
        </div>
    </div>
</div>