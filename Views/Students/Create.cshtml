@model StepByStep.Models.Student

@{
    ViewData["Title"] = "إضافة طالب جديد";
}

<div class="container mt-4" dir="rtl" style="text-align: right;">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">إضافة طالب جديد</h4>
                </div>
                <div class="card-body">
                    <form asp-action="Create">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="StudentId" class="form-label">اختر المستخدم (الطالب)</label>
                            <select asp-for="StudentId" class="form-select" asp-items="ViewBag.StudentId">
                                <option value="">-- اختر الطالب من القائمة --</option>
                            </select>
                            <span asp-validation-for="StudentId" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ParentId" class="form-label">ولي الأمر</label>
                            <select asp-for="ParentId" class="form-select" asp-items="ViewBag.ParentId">
                                <option value="">-- اختر ولي الأمر --</option>
                            </select>
                            <span asp-validation-for="ParentId" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="GradeLevel" class="form-label">المرحلة الدراسية / الصف</label>
                            <input asp-for="GradeLevel" class="form-control" placeholder="مثال: الصف الخامس" />
                            <span asp-validation-for="GradeLevel" class="text-danger"></span>
                        </div>

                        <div class="d-flex justify-content-between mt-4">
                            <a asp-action="Index" class="btn btn-secondary">العودة للقائمة</a>
                            <button type="submit" class="btn btn-success">حفظ البيانات</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}