@model IEnumerable<StepByStep.Models.Student>
@inject StepByStep.Models.StepByStepDbContext _context

@{
    ViewData["Title"] = "إدارة الطلاب";
}

<div class="container mt-4" dir="rtl" style="text-align: right;">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>إدارة الطلاب</h2>
        <a asp-action="Create" class="btn btn-primary">+ إضافة طالب جديد</a>
    </div>

    <table class="table table-striped table-bordered shadow-sm bg-white text-center">
        <thead class="table-dark">
            <tr>
                <th>رقم الطالب</th>
                <th>اسم الطالب</th>
                <th>البريد الإلكتروني</th>
                <th>المرحلة الدراسية</th>
                <th>الإجراءات</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    var studentUser = _context.Users.FirstOrDefault(u => u.UserId == item.StudentId);
                    <tr>
                        <td>@item.StudentId</td>
                        <td>@(studentUser?.FullName ?? "غير متوفر")</td>
                        <td>@(studentUser?.Email ?? "غير متوفر")</td>
                        <td>@item.GradeLevel</td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@item.StudentId" class="btn btn-sm btn-warning">تعديل</a> |
                            <a asp-action="Details" asp-route-id="@item.StudentId" class="btn btn-sm btn-info text-white">تفاصيل</a> |
                            <a asp-action="Delete" asp-route-id="@item.StudentId" class="btn btn-sm btn-danger">حذف</a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="5" class="text-muted">لا توجد بيانات طلاب مضافة حالياً.</td>
                </tr>
            }
        </tbody>
    </table>
</div>